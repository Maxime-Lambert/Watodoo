# TLS terminé par la passerelle Caddy partagée du VPS (/opt/gateway) :
# ce conteneur ne sert que du HTTP interne sur le réseau Docker `gateway`.
:80 {
	handle /api/* {
		uri strip_prefix /api
		reverse_proxy backend:8080
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
