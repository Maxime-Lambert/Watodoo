# Template pour docker-compose.prod.yml — copier en .env sur le VPS et
# remplir avec de vraies valeurs (jamais commiter le .env rempli).

# Mot de passe PostgreSQL prod (différent du mot de passe dev)
POSTGRES_PASSWORD=

# Clé de signature JWT, >= 32 octets. Générer avec : openssl rand -base64 48
JWT_SIGNING_KEY=

# Nom de domaine de prod (ex. watodoo.fr), sans protocole ni slash final
DOMAIN=
