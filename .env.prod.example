# Template pour docker-compose.prod.yml — copier en .env sur le VPS et
# remplir avec de vraies valeurs (jamais commiter le .env rempli).

# Mot de passe PostgreSQL prod (différent du mot de passe dev)
POSTGRES_PASSWORD=

# Clé de signature JWT, >= 32 octets. Générer avec : openssl rand -base64 48
JWT_SIGNING_KEY=

# Nom de domaine de prod (ex. watodoo.fr), sans protocole ni slash final
DOMAIN=

# Token API Cloudflare (Zone:DNS:Edit sur la zone du domaine uniquement) —
# nécessaire car le domaine est proxifié par Cloudflare, Caddy prouve la
# possession du domaine via DNS-01 plutôt que HTTP-01. À créer sur
# dash.cloudflare.com/profile/api-tokens (template "Edit zone DNS").
CLOUDFLARE_API_TOKEN=

# Client ID/Secret IGDB (flux OAuth2 client-credentials via Twitch). À créer sur
# https://dev.twitch.tv/console/apps ("Application Backend Service", l'URL de
# redirection est inutilisée par ce flux). Alimente l'ingestion des jeux vidéo
# (plans/active-plan.md).
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Clé secrète protégeant les endpoints internes de déclenchement manuel
# d'ingestion (POST /internal/ingestion/games/{igdb,enrich-french}, et plus
# tard les mêmes endpoints pour les autres catégories). Générer avec :
# openssl rand -base64 32
INGESTION_ADMIN_KEY=
